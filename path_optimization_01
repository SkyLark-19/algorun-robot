# --- Helper Functions (AStarNode, heuristic, get_neighbors, a_star_search, raw_to_distance_fn, update_odometry, world_to_grid_coords, grid_to_world_coords_center) ---
class AStarNode:
    def __init__(self, position, parent=None): self.position = position; self.parent = parent; self.g = 0; self.h = 0; self.f = 0
    def __eq__(self, other): return self.position == other.position
    def __lt__(self, other): return self.f < other.f
    def __hash__(self): return hash(self.position)
def heuristic(node_pos, goal_pos): return abs(node_pos[0] - goal_pos[0]) + abs(node_pos[1] - goal_pos[1])
def get_neighbors(current_node_pos, grid_dim_x_astar, grid_dim_y_astar):
    neighbors = []; movimientos = [(0,1),(0,-1),(1,0),(-1,0)] 
    for mov in movimientos:
        neighbor_pos = (current_node_pos[0] + mov[0], current_node_pos[1] + mov[1])
        if 0 <= neighbor_pos[0] < grid_dim_x_astar and 0 <= neighbor_pos[1] < grid_dim_y_astar:
            neighbors.append(neighbor_pos)
    return neighbors
def a_star_search(grid_map_numpy_astar, start_pos_grid_astar, goal_pos_grid_astar): 
    print(f"A* Search: Start {start_pos_grid_astar}, Goal {goal_pos_grid_astar}")
    if start_pos_grid_astar == goal_pos_grid_astar: 
        print("A* Warning: Start and Goal are the same. Path is just the start/goal cell."); 
        return [start_pos_grid_astar] 
    start_node = AStarNode(start_pos_grid_astar); goal_node = AStarNode(goal_pos_grid_astar)
    open_list_astar = []; heapq.heappush(open_list_astar, start_node)
    closed_set_astar = set()
    max_iterations = GRID_DIM_X * GRID_DIM_Y * 5; iterations = 0 
    path_found_flag = False
    final_node = None
    while open_list_astar and iterations < max_iterations:
        iterations += 1; current_node = heapq.heappop(open_list_astar)
        if current_node.position in closed_set_astar: continue
        closed_set_astar.add(current_node.position)
        if current_node == goal_node: path_found_flag = True; final_node = current_node; break
        for neighbor_pos_grid_astar in get_neighbors(current_node.position, GRID_DIM_X, GRID_DIM_Y): 
            if neighbor_pos_grid_astar in closed_set_astar: continue
            neighbor_map_col_idx = neighbor_pos_grid_astar[0]
            neighbor_map_row_idx = GRID_DIM_Y - 1 - neighbor_pos_grid_astar[1] 
            if not (0 <= neighbor_map_row_idx < GRID_DIM_Y and 0 <= neighbor_map_col_idx < GRID_DIM_X): continue
            if grid_map_numpy_astar[neighbor_map_row_idx, neighbor_map_col_idx] == 2: continue 
            neighbor_node = AStarNode(neighbor_pos_grid_astar, current_node)
            neighbor_node.g = current_node.g + 1; neighbor_node.h = heuristic(neighbor_node.position, goal_node.position)
            neighbor_node.f = neighbor_node.g + neighbor_node.h
            in_open_list_flag = False
            for i, open_node_tuple_astar_node in enumerate(open_list_astar):
                if neighbor_node == open_node_tuple_astar_node: 
                    in_open_list_flag = True
                    if neighbor_node.g < open_node_tuple_astar_node.g: 
                        open_list_astar[i] = neighbor_node; heapq.heapify(open_list_astar)
                    break
            if not in_open_list_flag: heapq.heappush(open_list_astar, neighbor_node)
    if path_found_flag and final_node:
        path = []; temp = final_node
        while temp is not None: path.append(temp.position); temp = temp.parent
        print(f"A* Path found in {iterations} iterations, length {len(path)}."); return path[::-1] 
    print(f"A* Path not found after {iterations} iterations."); return None
def raw_to_distance_fn(sensor_raw_value): 
    if sensor_raw_value is None: return SENSOR_MAX_DIST
    try: val_float = float(sensor_raw_value)
    except (ValueError, TypeError): return SENSOR_MAX_DIST
    clamped_raw = max(0.0, min(val_float, MAX_SENSOR_RAW_VALUE))
    distance = SENSOR_MAX_DIST - (clamped_raw / MAX_SENSOR_RAW_VALUE) * (SENSOR_MAX_DIST - SENSOR_MIN_DIST)
    return distance
def update_odometry(): 
    global robot_pose, prev_left_encoder_val, prev_right_encoder_val
    if not (encoder_left and encoder_right): return 
    current_left_enc = encoder_left.getValue(); current_right_enc = encoder_right.getValue()
    delta_left_rad = current_left_enc - prev_left_encoder_val; delta_right_rad = current_right_enc - prev_right_encoder_val
    dist_left = delta_left_rad * WHEEL_RADIUS; dist_right = delta_right_rad * WHEEL_RADIUS
    delta_dist = (dist_left + dist_right) / 2.0; current_yaw = robot_pose[2] 
    if imu: imu_rpy = imu.getRollPitchYaw(); current_yaw = imu_rpy[2] 
    else: delta_theta_enc = (dist_right - dist_left) / WHEEL_DISTANCE; current_yaw += delta_theta_enc
    dx = delta_dist * math.cos(robot_pose[2]); dy = delta_dist * math.sin(robot_pose[2])
    robot_pose[0] += dx; robot_pose[1] += dy; robot_pose[2] = current_yaw 
    while robot_pose[2] > math.pi: robot_pose[2] -= 2 * math.pi
    while robot_pose[2] < -math.pi: robot_pose[2] += 2 * math.pi
    prev_left_encoder_val = current_left_enc; prev_right_encoder_val = current_right_enc
def world_to_grid_coords(world_x, world_y): 
    grid_x = int((world_x - MAP_ORIGIN_X_WORLD) / CELL_SIZE)
    grid_y = int((world_y - MAP_ORIGIN_Y_WORLD) / CELL_SIZE) 
    grid_x = max(0, min(grid_x, GRID_DIM_X - 1)); grid_y = max(0, min(grid_y, GRID_DIM_Y - 1))
    return grid_x, grid_y 
def grid_to_world_coords_center(grid_x_col, grid_y_from_world_origin): 
    world_x = (grid_x_col + 0.5) * CELL_SIZE + MAP_ORIGIN_X_WORLD
    world_y = (grid_y_from_world_origin + 0.5) * CELL_SIZE + MAP_ORIGIN_Y_WORLD
    return world_x, world_y

