    if apply_new_motor_speeds_this_step:
        clamped_left_speed = max(-MAX_MOTOR_SPEED, min(MAX_MOTOR_SPEED, target_speed_actual_left_this_step))
        clamped_right_speed = max(-MAX_MOTOR_SPEED, min(MAX_MOTOR_SPEED, target_speed_actual_right_this_step))
        if motor_actual_left: motor_actual_left.setVelocity(clamped_left_speed)
        if motor_actual_right: motor_actual_right.setVelocity(clamped_right_speed)
        last_left_cmd_vel_for_log = clamped_left_speed; last_right_cmd_vel_for_log = clamped_right_speed

    if step_counter % log_interval == 0:
        # ... (Full logging ...
        print(f"Time: {robot.getTime():.1f}s | Action: {action_this_step} | Lap: {lap_count} | StuckCtr: {stuck_on_side_wall_counter} | State: {current_robot_state}")
        print(f"  Pose(x,y,th_deg): {robot_pose[0]:.2f}, {robot_pose[1]:.2f}, {math.degrees(robot_pose[2]):.1f}")
        print(f"  Grid Cell (col,row_map_idx): ({map_col_idx_robot}, {map_row_idx_robot})")
        raw_log_str = ",".join([f"{v:.0f}" for v in raw_sensor_values_for_log]); print(f"  RAW_AllSensors: [{raw_log_str}]")
        print(f"  DIST(L,FL,F,FR,R): {dist_L:.3f},{dist_FL:.3f},{dist_F:.3f},{dist_FR:.3f},{dist_R:.3f}m")
        print(f"  Motor CMD (L,R): {current_log_left_vel:.2f}, {current_log_right_vel:.2f} rad/s") 
        if camera and camera_width > 0: print(f"  Red Line: {red_line_detected_this_step} (Debounce: {red_line_debounce_timer})")
        if current_robot_state == STATE_IN_MANEUVER: print(f"  Maneuver Steps Left: {time_in_maneuver}") 
        elif current_robot_state == STATE_PATH_FOLLOWING and not (action_this_step.startswith("PATH_COMPLETE") ): print(f"  Path Following WP Idx: {current_path_target_idx}/{len(planned_path_world)-1 if planned_path_world else 0}")

    
    if step_counter % map_print_interval == 0 and lap_count <= TARGET_LAPS_EXPLORE : 
        # ...Map printing ...
        print(f"--- Occupancy Grid at Time {robot.getTime():.1f}s (0=Unk,1=Trav,2=Obst) ---") 
        row_ds = max(1, GRID_DIM_Y // 20 if GRID_DIM_Y > 0 else 1); col_ds = max(1, GRID_DIM_X // 40 if GRID_DIM_X > 0 else 1) 
        print_grid = occupancy_grid[::row_ds, ::col_ds]
        for row_data in print_grid: print("".join(['#' if cell == 1 else ('X' if cell == 2 else '.') for cell in row_data]))
        print("-------------------------------------------------------------")