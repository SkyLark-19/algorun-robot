                current_lap_end_grid_cell = (map_col_idx_robot, current_grid_y_robot_world_origin)
                
                lap_count += 1 # Increment lap count first
                print(f"********** RED LINE DETECTED! Now Lap: {lap_count}, Pose: ({robot_pose[0]:.2f}, {robot_pose[1]:.2f}, {math.degrees(robot_pose[2]):.1f}deg) **********")
